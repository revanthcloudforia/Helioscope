		<until-successful maxRetries="5" doc:name="Until Successful" doc:id="33202930-c341-4b5c-a12f-726d3992e825">
				<http:request method="GET" doc:name="Helioscope api request to get projects" doc:id="df3c10ec-1960-4679-b5ce-b86049321993" config-ref="HTTP_Request_configuration" path="/projects/?offset=0&amp;limit=5000" sendCorrelationId="AUTO">
				<http:headers><![CDATA[#[output application/java
					---
					{
					"access_token": "${secure::helioscope.access_token}"
					}]]]>
				</http:headers>
			</http:request>
		</until-successful>
		<ee:transform doc:name="Transform Message" doc:id="af83ba1d-418d-4afd-aa78-16263af7067e">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="project"><![CDATA[%dw 2.0
output application/java
---
payload map {
helioscope_project_api_id__c: $.project_id as String,
Name: $.name,
PreparedByEmail__c :  $.creator.email,
DateHelioProjectCreated__c	: $.created as DateTime as Date {format: "MM/dd/yyyy"},
helioscope_project_address__c: $.address,
project_data_json__c: write($, "application/json")					  
