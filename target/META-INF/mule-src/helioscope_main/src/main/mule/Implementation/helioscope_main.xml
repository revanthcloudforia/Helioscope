	<flow name="helioscope_Designs"
		doc:id="54e97284-fea9-4efa-9b22-160064de3766">
		<!-- Transform payload to extract project_id as vars.id -->
		<logger level="INFO" doc:name="Design flow started" doc:id="56a01423-f121-4e0e-a934-6f6a078844f3" message='#["Design flow started"]'/>
		<ee:transform doc:name="Transform Message"
			doc:id="28886fcd-1f07-4112-b4f0-204e540d7982">
			<ee:variables>
				<ee:set-variable variableName="id"><![CDATA[%dw 2.0
output application/json
---
payload.helioscope_project_api_id__c
                ]]>
				</ee:set-variable>
			</ee:variables>
		</ee:transform>

		<!-- Iterate over the array of project IDs in vars.id -->
		<logger level="INFO" doc:name="projectId logger" doc:id="3fd3d212-306f-40fb-8d85-6dfb1e4a41ef" message='#["calling designs with projectId :" ++ (vars.id default "null")]'/>
		<until-successful maxRetries="5" doc:name="Until Successful" doc:id="c1d86bb8-9c21-4268-a18d-dc6eab85caeb">
				<!-- HTTP Request to fetch designs based on project_id -->
				<http:request method="GET" doc:name="Helioscope api request to get designs" doc:id="74a9cfa9-7fb3-445e-8cac-a187a50e7ae2" config-ref="HTTP_Request_configuration" path='#[("/designs?project_id=") ++ (vars.id)]' doc:description="The helioscope_project_api_id needs to lookup in Salesforce the project and store the project relationship ID." responseTimeout="600000">

					<!-- Include headers correctly -->
					<reconnect />
				<http:headers><![CDATA[#[{
							"access_token": "${secure::helioscope.access_token}"
					}]]]>
                </http:headers>
				</http:request>
			</until-successful>
		<set-variable value="#[payload]" doc:name="Set designResponse" doc:id="60c7ee9e-de6f-4c55-9f7d-d4642ca887c2" variableName="designResponse"/>
		<ee:transform doc:name="Transform Message" doc:id="37ff20ed-f674-40e1-869b-b9b852a2db6c" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="resp" ><![CDATA[%dw 2.0
output application/json
//var design = (payload orderBy $.created ) orderBy $.last_modified [-1 to 0]
var design = payload

//var wiringzones =  keysOf(payload.field_component_metadata.wiring_zones)
---
design map {
   helioscope_design_api_id__c: $.design_id as String, 
   helioscope_project_api_id__r: {
       helioscope_project_api_id__c: $.project_id as String
   },
    AC_Nameplate__c: $.field_component_metadata.ac_nameplate as String default "N/A",
    DC_Nameplate__c: $.field_component_metadata.nameplate as String default "N/A",
    DesignPNG_URL__c: $.render_url,
   // DXF_URL__c: $.dxf_export_file_id,
    Name: $.description,
   DesignCreatorID__c: $.creator_id as String,
   DesignCreatedDate__c: if ($.created != null) $.created else null,
    DesignLastModifiedDate__c: if ($.last_modified != null) $.last_modified else null,
    LastModifiedByUser__c: $.last_modified_by_user.full_name,
    wiring_zones : $.field_component_metadata.wiring_zones,
    "fieldSegments" : keysOf($.field_component_metadata.field_segments default {}) 
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<foreach doc:name="For Each" doc:id="5f9f9c25-491a-419a-b830-abfeb6d1a462" collection='#[%dw 2.0&#10;output application/json skipNullOn="everywhere"&#10;---&#10;vars.resp]'>
			<set-variable value="#[payload]" doc:name="Set designPayload" doc:id="eae37c00-341f-4425-af81-1776e7809e15" variableName="designPayload"/>
			<set-variable value="#[[]]" doc:name="Set FieldSegmentArray" doc:id="78a4bba6-7587-4367-b100-c58c4fb7a5c5" variableName="FieldSegmentArray"/>
			<foreach doc:name="For Each" doc:id="57170c16-a51a-46c6-9991-d4ccab4f73bc" collection="#[payload.fieldSegments]">
				<until-successful maxRetries="5" doc:name="Until Successful" doc:id="1aa0d37e-35f0-4d3a-95f7-298edf2fa78a">
					<http:request method="GET" doc:name="Helioscope api request to get fieldsegements" doc:id="1d504f9f-bf45-4478-9167-70451e69ac12" doc:description="The helioscope_project_api_id needs to lookup in Salesforce the project and store the project relationship ID." config-ref="HTTP_Request_configuration" path='#["/field_segments/" ++ payload]' responseTimeout="60000">
					<http:headers><![CDATA[#[{
							"access_token": "${secure::helioscope.access_token}"
					}]]]></http:headers>
				</http:request>
			</until-successful>
				<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;{&#10;  alignment : payload.alignment,&#10;  azimuth : payload.azimuth,&#10;  area : payload.data.area,&#10;  frames : payload.data.frames,&#10;  modules : payload.data.modules,&#10;  power : payload.data.power,&#10;  description : payload.description,&#10;  field_segment_id  : payload.field_segment_id&#10;}]" doc:name="Set fieldSegmentResponse" doc:id="d42e7f73-3841-4056-b47f-005d9d7055e3" variableName="fieldSegmentResponse" />
				<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.FieldSegmentArray ++ [vars.fieldSegmentResponse]]" doc:name="adding FieldSegmentResponse to Array" doc:id="824b1a4d-7cce-4453-b594-1019ed692908" variableName="FieldSegmentArray" />
				<remove-variable doc:name="Remove fieldSegmentResponse" doc:id="edefb220-85c6-4ab1-857a-32ccee0bc8fa" variableName="fieldSegmentResponse" />
				<logger level="INFO" doc:name="designPayload after adding fieldSegment of individual design" doc:id="dc7b4fa0-36d1-4381-b037-7f187607d040" message="#[vars.designPayload]" />
			</foreach>
			<set-variable value='#[%dw 2.0&#10;output application/json&#10;---&#10;((vars.designPayload - "fieldSegments") ++ {"feildSegmentData "  : [  vars.FieldSegmentArray ] })]' doc:name="add fieldSegmentsArray to designPayload" doc:id="77a520c8-652f-4ad7-8c6f-4548c302d63a" variableName="designPayload" />
			<remove-variable doc:name="Remove FieldSegmentArray" doc:id="0cf27183-7d90-49a0-819b-8476a610ed38" variableName="FieldSegmentArray"/>
			<ee:transform doc:name="Transform Message" doc:id="8502a9d6-3262-432c-8196-f0e843ed593d">
				<ee:message>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="design"><![CDATA[%dw 2.0
output application/java
---
 [{
    helioscope_design_api_id__c: vars.designPayload.helioscope_design_api_id__c as String, 
   helioscope_project_api_id__r: vars.designPayload.helioscope_project_api_id__r,
    AC_Nameplate__c: vars.designPayload.AC_Nameplate__c as String default "N/A",
    DC_Nameplate__c: vars.designPayload.DC_Nameplate__c as String default "N/A",
    DesignPNG_URL__c: vars.designPayload.DesignPNG_URL__c,
    DXF_URL__c: vars.designPayload.DXF_URL__c default null,
    Name: vars.designPayload.Name,
   DesignCreatorID__c: vars.designPayload.DesignCreatorID__c as String,
   DesignCreatedDate__c: vars.designPayload.DesignCreatedDate__c as DateTime as Date {format: "MM/dd/yyyy"}  default null,
    DesignLastModifiedDate__c: vars.designPayload.DesignLastModifiedDate__c as DateTime as Date {format: "MM/dd/yyyy"} default null,
    LastModifiedByUser__c: vars.designPayload.LastModifiedByUser__c,
   design_data_json__c: write(vars.designPayload, "application/json")
}]
]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<remove-variable doc:name="Remove designPayload" doc:id="fbc525d6-2d88-4e5f-8455-3e642ae22b4b" variableName="designPayload"/>
			<until-successful maxRetries="5" doc:name="Until Successful" doc:id="1682ad40-8dee-491c-97e4-a77871e7c62e">
					<salesforce:upsert doc:name="Upsert designs into salesforce" doc:id="320f3a0c-0ac5-4188-88bc-7e81c3ee0071" config-ref="Salesforce_Config" objectType="Helioscope_Design__c" externalIdFieldName="helioscope_design_api_id__c">
					<salesforce:records ><![CDATA[#[vars.design]]]></salesforce:records>
					</salesforce:upsert>
				</until-successful>
			<logger level="INFO" doc:name="Logger" doc:id="92af38ca-62f3-4430-bc82-acd5c08fc9df" />
		</foreach>

		<!-- Transform the design data -->

		<!-- Iterate through transformed design data and upsert to Salesforce -->

		<!-- Log after processing -->
		<logger level="INFO" doc:name="Design flow ended"
			doc:id="bdbf7990-f16a-4130-b00e-6caf989a289e" message='#["Design flow ended"]'/>
	</flow>
